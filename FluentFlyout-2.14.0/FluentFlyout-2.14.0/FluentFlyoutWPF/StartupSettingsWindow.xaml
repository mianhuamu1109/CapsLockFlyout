<Window x:Class="FluentFlyoutWPF.StartupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CapsLockFlyout 设置"
        Width="550"
        Height="620"
        MinWidth="550"
        MinHeight="620"
        MaxWidth="550"
        MaxHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei"
        FontSize="13"
        Background="#F3F3F3">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20"
                   FontWeight="DemiBold"
                   Foreground="#1A1A1A"
                   Text="CapsLockFlyout" />
        <TextBlock Grid.Row="1"
                   Margin="0,4,0,0"
                   Foreground="#666666"
                   Text="浮窗服务正在后台运行" />

        <Border Grid.Row="2"
                Margin="0,18,0,18"
                Padding="14,12"
                CornerRadius="7"
                BorderThickness="1"
                BorderBrush="#18000000"
                Background="#FFFFFFFF">
            <StackPanel>
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          FontWeight="DemiBold"
                          Content="通过 Windows 服务开机自启"
                          Checked="OnStartupChoiceChanged"
                          Unchecked="OnStartupChoiceChanged" />
                <TextBlock Margin="24,6,0,0"
                           Foreground="#666666"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="服务会在开机时启动，并在登录或解锁后尽早显示托盘图标。更改此项需要管理员授权。" />
                <TextBlock x:Name="StatusText"
                           Margin="24,5,0,0"
                           Foreground="#C42B1C"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,0,0,18" Padding="14,12"
                CornerRadius="7" BorderThickness="1" BorderBrush="#18000000"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="DemiBold" Text="输入法浮窗禁用程序" />
                <TextBlock Grid.Row="1" Margin="0,6,0,10" Foreground="#666666"
                           FontSize="12" TextWrapping="Wrap"
                           Text="所选 EXE 的窗口位于前台时，不显示输入法浮窗。大写锁定与硬件提示不受影响。按完整路径匹配，更改立即保存。" />
                <Grid Grid.Row="2">
                    <ListBox x:Name="ExcludedProgramsList" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="OnExclusionSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4" ToolTip="{Binding FullPath}">
                                    <TextBlock Text="{Binding Name}" FontWeight="DemiBold" />
                                    <TextBlock Text="{Binding FullPath}" Foreground="#666666"
                                               FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyExclusionsText" Text="尚未添加程序"
                               IsHitTestVisible="False" Foreground="#888888"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AddExclusionButton" Content="添加程序…" Width="98" Height="30"
                            Click="OnAddExclusionClick" />
                    <Button x:Name="RemoveExclusionButton" Content="移除所选" Width="98" Height="30"
                            Margin="8,0,0,0" IsEnabled="False" Click="OnRemoveExclusionClick" />
                </StackPanel>
                <TextBlock x:Name="ExclusionStatusText" Grid.Row="4" Margin="0,6,0,0"
                           FontSize="12" Foreground="#666666" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="88"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="OnExitClick"
                    Content="退出程序" />
            <Button Width="88"
                    Height="30"
                    IsDefault="True"
                    Click="OnDoneClick"
                    Content="完成" />
        </StackPanel>
    </Grid>
</Window>
