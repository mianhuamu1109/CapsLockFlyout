<Window x:Class="FluentFlyoutWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caps Lock Flyout"
        Width="192"
        Height="48"
        MinWidth="129"
        MaxWidth="280"
        MinHeight="48"
        MaxHeight="48"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        Left="-32000"
        Top="-32000">
    <Border x:Name="Surface"
            CornerRadius="8"
            BorderThickness="0"
            Padding="12,6"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="IconHost"
                  Grid.Column="0"
                  Width="23"
                  Height="24"
                  Margin="0,0,7,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="GenericIconScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="GenericIconBounce" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <TextBlock x:Name="IconText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="20"
                           TextAlignment="Center"
                           Text="&#xE7F4;" />

                <Viewbox x:Name="LockSymbol"
                         Width="22"
                         Height="22"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="Collapsed">
                    <Canvas Width="24" Height="24" ClipToBounds="False">
                        <Path Data="M7.25 7A3.25 3.25 0 0 0 4 10.25v7.5C4 19.55 5.46 21 7.25 21h9.5c1.8 0 3.25-1.46 3.25-3.25v-7.5C20 8.45 18.54 7 16.75 7H7.25Zm0 1.5h9.5c.97 0 1.75.78 1.75 1.75v7.5c0 .97-.78 1.75-1.75 1.75h-9.5c-.97 0-1.75-.78-1.75-1.75v-7.5c0-.97.78-1.75 1.75-1.75Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                        <Path Data="M12 15.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                        <Path x:Name="LockShackle"
                              Data="M8 7V5a4 4 0 0 1 8 0v2h-1.5V5a2.5 2.5 0 0 0-5 0v2H8Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="ShackleRotation" Angle="0" CenterX="16" CenterY="7" />
                                    <TranslateTransform x:Name="ShackleBounce" Y="0" />
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Grid>

            <Grid x:Name="TextContentHost" Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText"
                           Grid.Row="0"
                           Grid.Column="0"
                           MaxWidth="100"
                           FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                           FontSize="12"
                           FontWeight="DemiBold"
                           TextTrimming="CharacterEllipsis"
                           Text="大写锁定" />

                <TextBlock x:Name="DetailText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                           FontSize="11.5"
                           Opacity="0.68"
                           TextTrimming="CharacterEllipsis"
                           Text="已开启" />

                <Grid x:Name="ProgressHost"
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Height="3"
                      Margin="0,3,0,0"
                      Visibility="Collapsed">
                    <Border x:Name="ProgressTrack" CornerRadius="1.5" Opacity="0.16" />
                    <Border x:Name="ProgressFill"
                            Width="0"
                            HorizontalAlignment="Left"
                            CornerRadius="1.5" />
                </Grid>
            </Grid>

            <Border x:Name="StateIndicator"
                    Grid.ColumnSpan="2"
                    Width="60"
                    Height="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    CornerRadius="2"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
