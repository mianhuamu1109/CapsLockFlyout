<Window x:Class="FluentFlyoutWPF.InstalledApplicationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择已安装应用" Width="580" Height="560" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI, Microsoft YaHei"
        FontSize="13" Background="#F3F3F3" Loaded="OnLoaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="选择商店 / MSIX 应用，按应用身份禁用，正常更新后仍有效。"
                   TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBox x:Name="SearchBox" Grid.Row="1" Height="30" Padding="6,4"
                 ToolTip="搜索应用名称或标识" TextChanged="OnSearchChanged" />
        <ListBox x:Name="ApplicationsList" Grid.Row="2" Margin="0,12,0,10"
                 SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6" ToolTip="{Binding Identity}">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="DemiBold" />
                        <TextBlock Text="{Binding Identity}" Foreground="#666666"
                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="LoadStatusText" Grid.Row="3" Text="正在读取应用列表…"
                   TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,12" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Width="88" Height="30" />
            <Button x:Name="AcceptButton" Content="添加所选" IsEnabled="False"
                    Width="98" Height="30" Margin="8,0,0,0" Click="OnAcceptClick" />
        </StackPanel>
    </Grid>
</Window>
